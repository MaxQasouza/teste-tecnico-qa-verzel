{
  "name": "verzel-store-qa",
  "version": "1.0.0",
  "description": "QA do card VZS-142 da Verzel Store (cupom de desconto e frete grátis): cenários BDD, report de bugs e testes automatizados com Playwright + TypeScript",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:bugs": "cross-env EXPOR_BUGS=1 playwright test",
    "test:api": "playwright test --project=api",
    "test:e2e": "playwright test --project=e2e",
    "report": "playwright show-report",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "evidencias": "node tools/coletar-evidencias.mjs",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "playwright",
    "qa",
    "e2e",
    "api-testing",
    "allure"
  ],
  "author": "Maxswell Souza",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "allure-commandline": "^2.46.1",
    "allure-playwright": "^3.13.0",
    "cross-env": "^10.1.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}